node_modules/
dist/
.vite/
*.tsbuildinfo
docs/

# Runtime state (large generated files)
data/state/current_snapshot.json
data/state/external_repos.json

# Pipeline temp files
scripts/temp/

# Raw pipeline data
data/raw/
data/output/

# Phone database, exports, and runtime logs
data/fresh.db
data/fresh.db-wal
data/fresh.db-shm
data/morphe.db
data/morphe.db-wal
data/morphe.db-shm
data/exports/

# Generated copy of data/ (Vite serves data/ directly)
public/data/

